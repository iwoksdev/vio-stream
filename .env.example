# Local development; copy to .env. Never commit secrets.
PORT=5173
DATA_DIR=.data
DOWNLOAD_DIR=.data/downloads
YTS_API_BASE=https://movies-api.accel.li/api/v2/
ALLOW_REGISTRATION=true
# In production, use an HTTPS origin and secure cookies.
APP_ORIGIN=
COOKIE_SECURE=false

# Optional media library. Keys remain on the server; no VITE_ prefix.
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Optional Jellyfin user ID to apply that user's library visibility.
JELLYFIN_USER_ID=
MAX_PLAYBACK_TICKETS=50000

# Optional aria2 daemon. Keep RPC on a private network / loopback.
ARIA2_RPC_URL=
ARIA2_RPC_SECRET=
DOWNLOAD_ALLOWED_HOSTS=media.w3.org,download.blender.org,yts.gg
