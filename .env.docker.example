# Run npm run setup:docker to create .env.docker with a random secret.
# Never commit .env.docker or expose aria2 RPC publicly.
VIO_PORT=8080
ALLOW_REGISTRATION=true
COOKIE_SECURE=true
# For production HTTPS, set both to your own domain.
VIO_DOMAIN=localhost
APP_ORIGIN=

ARIA2_RPC_SECRET=
ARIA2_DOWNLOAD_LIMIT=0
DOWNLOAD_ALLOWED_HOSTS=media.w3.org,download.blender.org,yts.gg
YTS_API_BASE=https://movies-api.accel.li/api/v2/

# Optional profile: --profile library. Configure Jellyfin in its own setup UI.
# After creating an API key, use JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_PORT=8096
MEDIA_DIR=./media
MAX_PLAYBACK_TICKETS=50000
