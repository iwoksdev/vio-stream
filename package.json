{
  "name": "vio-movie-stream",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "export:html": "vite build --config vite.offline.config.ts && python scripts/export_preview.py",
    "test:platform": "node scripts/verify-platform.mjs",
    "user": "node scripts/manage-user.mjs",
    "setup:docker": "node scripts/setup-docker.mjs",
    "test:offline": "node scripts/verify-offline.mjs"
  },
  "dependencies": {
    "@videojs/hlsjs-video": "10.0.1",
    "@videojs/react": "10.0.1",
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
